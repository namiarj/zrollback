#!/bin/sh

name=${0##*/}
d=bsddialog

error ()
{
	echo "$name: $*" >&2
	exit 1
}

zprop ()
{
	prop=`zfs get -Ho property,value all "$snap"` || error "zfs get $snap failed"
	text=`printf "$snap\n$prop"`
	$d --msgbox "$text" 0 0
}

zdestroy ()
{
	$d --yesno --default-button No "Destroy $snap?" 0 0
	if [ $? -eq 0 ]; then
		zfs destroy $snap || error "zfs destroy $snap failed"
	fi
}

zrollback ()
{
	$d --yesno --default-button No "Rollback $snap?" 0 0
	if [ $? -eq 0 ]; then
		zfs rollback $snap || error "zfs rollback $snap failed" 
	fi
}

zlist ()
{
	list=`zfs list -Ht snapshot -o name` || error "zfs list failed"
	if [ -z "$list" ]; then
		echo "$name: no snapshot available"
		exit
	fi
	menu="$d --ok-label Property --extra-button --extra-label Rollback --help-button --help-label Destroy --no-tags --menu Snapshots 0 0 0"
	for s in $list; do
		menu="$menu $s $s"
	done
	$menu 2> $tmp
	button=$?
	snap=`cat $tmp`
	case $button in
	0)
		zprop
		;;
	2)
		snap="${snap#HELP }"
		zdestroy
		;;
	3)
		zrollback
		;;
	*)
		exit
	esac
}

tmp=`mktemp -t $name` || error "mktemp -t $name failed"
touch "$tmp" || error "writing $tmp failed"
trap "rm -f $tmp; exit" INT TERM HUP EXIT
while true; do
	zlist
done
